<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8f9fa; padding:20px 0;">
  <tr>
    <td align="center">

      <!-- Card -->
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.1); overflow:hidden;">
        <!-- Header -->
        <tr>
          <td style="background-color:#004aad; padding:20px; text-align:center; color:#ffffff;">
            <h1 style="margin:0; font-size:24px;">Welcome to Our Alumni Family!</h1>
          </td>
        </tr>

        <!-- Body -->
        <tr>
          <td style="padding:30px; color:#333333;">
            <p style="font-size:16px; line-height:24px; margin-bottom:20px;">
              Dear <strong><%= @user.name.titleize %> </strong>,
            </p>
            <p style="font-size:16px; line-height:24px; margin-bottom:20px;">
              We are thrilled to welcome you to the <strong>City University Alumni Network</strong>!
              You are now part of a strong and valuable community of graduates who are making an impact worldwide.
            </p>
            <p style="font-size:16px; line-height:24px; margin-bottom:20px;">
              Through our alumni platform, you can:
            </p>
            <ul style="font-size:16px; line-height:24px; color:#555555; padding-left:20px; margin-bottom:20px;">
              <li>Stay connected with former classmates and faculty.</li>
              <li>Access exclusive alumni events and updates.</li>
              <li>Support current students with mentorship opportunities.</li>
            </ul>

            <p style="text-align:center; margin:30px 0;">
              <a href="<%=@url  %>"
                 style="background-color:#004aad; color:#ffffff; padding:12px 25px; text-decoration:none; font-size:16px; font-weight:bold; border-radius:4px; display:inline-block;">
                Visit Alumni Portal
              </a>
            </p>

            <p style="font-size:16px; line-height:24px;">
              Welcome aboard, and let’s build a stronger alumni community together!
            </p>

            <p style="font-size:16px; line-height:24px; margin-top:30px;">
              Best regards, <br>
              <strong>City University Alumni Team</strong>
            </p>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="background-color:#f0f0f0; text-align:center; padding:15px; font-size:14px; color:#777777;">
            © 2025 City University Alumni Association. All rights reserved.
          </td>
        </tr>
      </table>
      <!-- End Card -->

    </td>
  </tr>
</table>


<div class="container py-5" style="margin-bottom: 2%;margin-top: 5%">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg border-0 rounded-lg" style="border-radius: 1rem;">
        <div class="card-body p-4">

          <div class="text-center mb-4">
            <%= image_tag("logo.webp", style: "width: 100px;", class: "img-fluid rounded-circle border border-white shadow-sm") %>
          </div>

          <h4 class="text-center mb-4 font-weight-bold text-primary">Sign In</h4>
          <% flash.each do |key, message| %>
            <div class="alert alert-<%= key %> text-danger"><%= message %></div>
          <% end %>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

            <div class="form-group">
              <label><i class="fa fa-envelope mr-2 text-primary"></i> Email</label>
              <%= f.email_field :login, class: "form-control form-control-lg", placeholder: "Email", required: true %>
            </div>

            <div class="form-group">
              <label><i class="fa fa-id-card mr-2 text-primary"></i> Password</label>
              <%= f.password_field :password, class: "form-control form-control-lg", placeholder: "Password", autocomplete: "current-password", required: true %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="field">
                <%= f.check_box :remember_me %>
                <%= f.label :remember_me %>
              </div>
            <% end %>
            <%# Optional Address Field %>
            <%#
            <div class="form-group">
              <label><i class="fa fa-map-marker mr-2 text-primary"></i> Present Address</label>
              <%= f.text_field :present_address, class: "form-control form-control-lg", placeholder: "Present Address" %>
            <div class="form-group mt-4">
              <%= f.submit "Login", class: "btn btn-primary btn-lg btn-block font-weight-bold rounded-pill" %>
            </div>
            </div>

          <% end %>
          </div>
    </div>
  </div>
</div>



<style>
    .carousel-img {
        max-height: 90%;
        object-fit: contain; /* Keeps full image, no crop */
        border-radius: 10px;
    }

    .carousel-caption {
        background: rgba(0, 0, 0, 0.5);
        border-radius: 8px;
    }

    .carousel-indicators li {
        background-color: #007bff;
    }
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        filter: invert(1);
    }




</style>

<section id="showcase" style="padding-bottom: 0">
  <div class="container-fluid right-position" id="recent-activity">
    <div class="row gradient-bg custom-bg">
      <div class="col-lg-12">
        <div class="showcase-text section-header text-center">
          <div class="pb-4">
            <h2 class="section-title">Recent Activity</h2>
          </div>
        </div>

        <div id="carouselExampleControls" class="carousel slide carousel-fade shadow-lg rounded" data-ride="carousel">

          <!-- Carousel Indicators -->
          <ol class="carousel-indicators">
            <% RecentEvent.all.each_with_index do |event, ind| %>
              <li data-target="#carouselExampleControls" data-slide-to="<%= ind %>" class="<%= 'active' if ind == 0 %>"></li>
            <% end %>
          </ol>

          <div class="carousel-inner rounded">
            <% RecentEvent.all.each_with_index do |event, ind| %>
              <div class="carousel-item <%= 'active' if ind == 0 %>">
                <%= image_tag(
                      event.image.present? ? event.image_url : 'activity/syed1.jpg',
                      class: "d-block w-100 carousel-img",
                      alt: "Recent Event"
                    ) %>
                <!-- Optional Caption -->
<!--                <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">-->
<!--                  <h5><%#= event.title if event.respond_to?(:title) %></h5>-->
<!--                  <p><%#= event.description.truncate(80) if event.respond_to?(:description) %></p>-->
<!--                </div>-->
              </div>
            <% end %>
          </div>

          <!-- Prev/Next Buttons -->
          <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
          </a>
          <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>



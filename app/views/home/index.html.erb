<div class="panel-header bg-primary-gradient">
  <div class="page-inner py-5">
    <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
      <div>
        <h2 class="text-white pb-2 fw-bold">Dashboard</h2>
        <h5 class="text-white op-7 mb-2">Admin Dashboard</h5>
      </div>
      <div class="ml-md-auto py-2 py-md-0">
      </div>
    </div>
  </div>
</div>
<div class="page-inner mt--5">
  <!-- Summary Cards Row -->
  <div class="row">
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-primary bubble-shadow-small">
                <i class="fas fa-users"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Total Users</p>
                <h4 class="card-title"><%= @total_users %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-info bubble-shadow-small">
                <i class="fas fa-user-clock"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Registrations</p>
                <h4 class="card-title"><%= @total_registrations %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-success bubble-shadow-small">
                <i class="fas fa-user-graduate"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Alumni</p>
                <h4 class="card-title"><%= @total_alumni %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-warning bubble-shadow-small">
                <i class="fas fa-user-tie"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Members</p>
                <h4 class="card-title"><%= @total_members %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt--2">
    <div class="col-md-6">
      <div class="card full-height">
        <div class="card-body">
          <div class="card-title">Overall Statistics</div>
          <div class="card-category">Real-time information about system statistics</div>
          <div class="d-flex flex-wrap justify-content-around pb-2 pt-4">
            <div class="px-2 pb-2 pb-md-0 text-center">
              <div id="circles-1"></div>
              <h6 class="fw-bold mt-3 mb-0">Registrations</h6>
            </div>
            <div class="px-2 pb-2 pb-md-0 text-center">
              <div id="circles-2"></div>
              <h6 class="fw-bold mt-3 mb-0">Alumni</h6>
            </div>
            <div class="px-2 pb-2 pb-md-0 text-center">
              <div id="circles-3"></div>
              <h6 class="fw-bold mt-3 mb-0">Members</h6>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card full-height">
        <div class="card-body">
          <div class="card-title">Total Collection & Spend Statistics</div>
          <div class="row py-3">
            <div class="col-md-4 d-flex flex-column justify-content-around">
              <div>
                <h6 class="fw-bold text-uppercase text-success op-8">Total Collection</h6>
                <h3 class="fw-bold">৳<%= number_with_delimiter(@total_event_income.to_f, delimiter: ',') %></h3>
              </div>
              <div>
                <h6 class="fw-bold text-uppercase text-danger op-8">Total Spend</h6>
                <h3 class="fw-bold">৳<%= number_with_delimiter(@total_event_expense.to_f, delimiter: ',') %></h3>
              </div>
            </div>
            <div class="col-md-8">
              <div id="chart-container">
                <canvas id="totalIncomeChart"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Additional Stats Row -->
  <div class="row">
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-secondary bubble-shadow-small">
                <i class="fas fa-calendar-alt"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Total Events</p>
                <h4 class="card-title"><%= @total_events %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-info bubble-shadow-small">
                <i class="fas fa-users-cog"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Committees</p>
                <h4 class="card-title"><%= @total_committees %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-success bubble-shadow-small">
                <i class="fas fa-images"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Photo Galleries</p>
                <h4 class="card-title"><%= @total_galleries %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-danger bubble-shadow-small">
                <i class="fas fa-chalkboard-teacher"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Teachers</p>
                <h4 class="card-title"><%= @total_teachers %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <div class="card-head-row">
            <div class="card-title">User Statistics</div>
            <div class="card-tools">
              <%= link_to user_list_path, class: "btn btn-info btn-border btn-round btn-sm" do %>
                <span class="btn-label"><i class="fa fa-eye"></i></span> View All
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="chart-container" style="min-height: 375px">
            <canvas id="statisticsChart"></canvas>
          </div>
          <div id="myChartLegend"></div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card full-height">
        <div class="card-header">
          <div class="card-title">User Distribution</div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped table-sm">
              <thead>
                <tr>
                  <th>Role</th>
                  <th class="text-right">Count</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><span class="badge badge-primary">Admin</span></td>
                  <td class="text-right"><strong><%= @total_admins %></strong></td>
                </tr>
                <tr>
                  <td><span class="badge badge-warning">Members</span></td>
                  <td class="text-right"><strong><%= @total_members %></strong></td>
                </tr>
                <tr>
                  <td><span class="badge badge-success">Alumni</span></td>
                  <td class="text-right"><strong><%= @total_alumni %></strong></td>
                </tr>
                <tr>
                  <td><span class="badge badge-info">Registrations</span></td>
                  <td class="text-right"><strong><%= @total_registrations %></strong></td>
                </tr>
                <tr>
                  <td><span class="badge badge-secondary">Ex-Students</span></td>
                  <td class="text-right"><strong><%= @total_ex_students %></strong></td>
                </tr>
                <tr>
                  <td><span class="badge badge-danger">Teachers</span></td>
                  <td class="text-right"><strong><%= @total_teachers %></strong></td>
                </tr>
                <tr class="table-active">
                  <td><strong>Total</strong></td>
                  <td class="text-right"><strong><%= @total_users %></strong></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="card full-height">
        <div class="card-header">
          <div class="card-head-row">
            <div class="card-title">Recent Users</div>
            <div class="card-tools">
              <%= link_to user_list_path, class: "btn btn-sm btn-label-info btn-round" do %>
                View All
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-body">
          <% if @recent_users.any? %>
            <% @recent_users.each do |user| %>
              <div class="d-flex">
                <div class="avatar">
                  <% if user.image.present? %>
                    <%= image_tag user.image.url, class: "avatar-img rounded-circle", alt: user.name %>
                  <% else %>
                    <span class="avatar-title rounded-circle border border-white bg-<%= %w[primary info success warning danger secondary].sample %>">
                      <%= user.name.present? ? user.name[0].upcase : 'U' %>
                    </span>
                  <% end %>
                </div>
                <div class="flex-1 ml-3 pt-1">
                  <h6 class="text-uppercase fw-bold mb-1">
                    <%= user.name %>
                    <% role_class = case user.role
                      when 'admin' then 'text-primary'
                      when 'member' then 'text-warning'
                      when 'alumni' then 'text-success'
                      when 'student' then 'text-info'
                      else 'text-muted'
                    end %>
                    <span class="<%= role_class %> pl-3"><%= user.role&.titleize %></span>
                  </h6>
                  <span class="text-muted"><%= user.email %></span>
                </div>
                <div class="float-right pt-1">
                  <small class="text-muted"><%= time_ago_in_words(user.created_at) %> ago</small>
                </div>
              </div>
              <div class="separator-dashed"></div>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-users fa-3x text-muted mb-3"></i>
              <p class="text-muted">No users found</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card full-height">
        <div class="card-header">
          <div class="card-head-row">
            <div class="card-title">Recent Alumni Events</div>
            <div class="card-tools">
              <% if defined?(AlumniEvent) %>
                <%= link_to alumni_events_path, class: "btn btn-sm btn-label-info btn-round" do %>
                  View All
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-body">
          <% if @recent_events.present? && @recent_events.any? %>
            <% @recent_events.each do |event| %>
              <div class="d-flex">
                <div class="avatar">
                  <span class="avatar-title rounded-circle border border-white bg-<%= event.status == 'completed' ? 'success' : (event.status == 'ongoing' ? 'primary' : 'info') %>">
                    <i class="fas fa-calendar-alt"></i>
                  </span>
                </div>
                <div class="flex-1 ml-3 pt-1">
                  <h6 class="text-uppercase fw-bold mb-1">
                    <%= event.title %>
                    <% status_class = case event.status
                      when 'planned' then 'text-warning'
                      when 'confirmed' then 'text-info'
                      when 'ongoing' then 'text-primary'
                      when 'completed' then 'text-success'
                      when 'cancelled' then 'text-danger'
                      else 'text-muted'
                    end %>
                    <span class="<%= status_class %> pl-3"><%= event.status&.titleize %></span>
                  </h6>
                  <span class="text-muted">
                    <%= event.event_date&.strftime('%b %d, %Y') || 'Date TBD' %>
                    <% if event.location.present? %>
                      | <%= event.location %>
                    <% end %>
                  </span>
                </div>
                <div class="float-right pt-1">
                  <small class="text-muted">৳<%= number_with_delimiter(event.total_income.to_f, delimiter: ',') %></small>
                </div>
              </div>
              <div class="separator-dashed"></div>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
              <p class="text-muted">No alumni events found</p>
              <% if current_user&.is_edit_access? && defined?(AlumniEvent) %>
                <%= link_to 'Create New Event', new_alumni_event_path, class: 'btn btn-primary btn-sm' %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Financial Summary Row -->
  <% if @total_event_income > 0 || @total_event_expense > 0 %>
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <div class="card-title">Financial Overview</div>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-3">
              <div class="card card-stats card-success card-round">
                <div class="card-body">
                  <div class="row">
                    <div class="col-5">
                      <div class="icon-big text-center">
                        <i class="fas fa-arrow-down text-white"></i>
                      </div>
                    </div>
                    <div class="col-7 col-stats">
                      <div class="numbers">
                        <p class="card-category text-white">Total Income</p>
                        <h4 class="card-title text-white">৳<%= number_with_delimiter(@total_event_income.to_f, delimiter: ',') %></h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-stats card-danger card-round">
                <div class="card-body">
                  <div class="row">
                    <div class="col-5">
                      <div class="icon-big text-center">
                        <i class="fas fa-arrow-up text-white"></i>
                      </div>
                    </div>
                    <div class="col-7 col-stats">
                      <div class="numbers">
                        <p class="card-category text-white">Total Expense</p>
                        <h4 class="card-title text-white">৳<%= number_with_delimiter(@total_event_expense.to_f, delimiter: ',') %></h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <% balance = @total_event_income.to_f - @total_event_expense.to_f %>
              <div class="card card-stats card-<%= balance >= 0 ? 'primary' : 'warning' %> card-round">
                <div class="card-body">
                  <div class="row">
                    <div class="col-5">
                      <div class="icon-big text-center">
                        <i class="fas fa-balance-scale text-white"></i>
                      </div>
                    </div>
                    <div class="col-7 col-stats">
                      <div class="numbers">
                        <p class="card-category text-white">Balance</p>
                        <h4 class="card-title text-white">৳<%= number_with_delimiter(balance.abs, delimiter: ',') %></h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card card-stats card-secondary card-round">
                <div class="card-body">
                  <div class="row">
                    <div class="col-5">
                      <div class="icon-big text-center">
                        <i class="fas fa-calendar-check text-white"></i>
                      </div>
                    </div>
                    <div class="col-7 col-stats">
                      <div class="numbers">
                        <p class="card-category text-white">Completed Events</p>
                        <h4 class="card-title text-white"><%= @completed_events %></h4>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>

<script>
  // Pass Ruby variables to JavaScript for charts
  var dashboardData = {
    totalRegistrations: <%= @total_registrations %>,
    totalAlumni: <%= @total_alumni %>,
    totalMembers: <%= @total_members %>,
    totalUsers: <%= @total_users %>,
    totalIncome: <%= @total_event_income.to_f %>,
    totalExpense: <%= @total_event_expense.to_f %>,
    userDistribution: <%= @user_role_distribution.to_json.html_safe %>,
    monthlyRegistrations: <%= @monthly_registrations.to_json.html_safe %>
  };

  // Initialize circles with real data
  $(document).ready(function() {
    // Override default circle values with real data
    if (typeof Circles !== 'undefined') {
      // Clear existing circles
      $('#circles-1').empty();
      $('#circles-2').empty();
      $('#circles-3').empty();

      Circles.create({
        id: 'circles-1',
        radius: 45,
        value: dashboardData.totalRegistrations,
        maxValue: Math.max(dashboardData.totalUsers, dashboardData.totalRegistrations, 1),
        width: 7,
        text: dashboardData.totalRegistrations,
        colors: ['#f1f1f1', '#FF9E27'],
        duration: 400,
        wrpClass: 'circles-wrp',
        textClass: 'circles-text',
        styleWrapper: true,
        styleText: true
      });

      Circles.create({
        id: 'circles-2',
        radius: 45,
        value: dashboardData.totalAlumni,
        maxValue: Math.max(dashboardData.totalUsers, dashboardData.totalAlumni, 1),
        width: 7,
        text: dashboardData.totalAlumni,
        colors: ['#f1f1f1', '#2BB930'],
        duration: 400,
        wrpClass: 'circles-wrp',
        textClass: 'circles-text',
        styleWrapper: true,
        styleText: true
      });

      Circles.create({
        id: 'circles-3',
        radius: 45,
        value: dashboardData.totalMembers,
        maxValue: Math.max(dashboardData.totalUsers, dashboardData.totalMembers, 1),
        width: 7,
        text: dashboardData.totalMembers,
        colors: ['#f1f1f1', '#177dff'],
        duration: 400,
        wrpClass: 'circles-wrp',
        textClass: 'circles-text',
        styleWrapper: true,
        styleText: true
      });
    }

    // Update income chart with real data if it exists
    if (typeof Chart !== 'undefined' && document.getElementById('totalIncomeChart')) {
      var ctx = document.getElementById('totalIncomeChart').getContext('2d');
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Income', 'Expense'],
          datasets: [{
            data: [dashboardData.totalIncome, dashboardData.totalExpense],
            backgroundColor: ['#2BB930', '#F25961'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          legend: {
            position: 'bottom'
          },
          layout: {
            padding: {
              left: 20,
              right: 20,
              top: 20,
              bottom: 20
            }
          }
        }
      });
    }
  });
</script>

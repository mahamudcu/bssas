<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="card shadow-lg border-0 rounded-lg" style="border-radius: 1rem;">
<!--      <div class="card shadow-lg border-0 rounded rounded-lg with-jolchap" style="border-radius: 1rem;">-->

        <!-- Watermark logo background -->
        <div class="jolchap-background"></div>

        <div class="card-body p-4 jolchap-wrapper">

          <div class="text-center mb-4">
            <%= image_tag("logo.png", style: "width: 100px;", class: "img-fluid rounded-circle border border-white shadow-sm") %>
          </div>

          <h4 class="text-center mb-4 font-weight-bold text-primary">Registration Form</h4>

          <%= form_for @user, url: submit_registration_path do |f| %>

            <div class="form-group">
              <label><i class="fa fa-user mr-2 text-primary"></i> Full Name*</label>
              <%= f.text_field :name, class: "form-control form-control-lg", placeholder: "Full Name", required: true %>
            </div>

            <div class="form-group">
              <label><i class="fa fa-envelope mr-2 text-primary"></i> Email*</label>
              <%= f.email_field :email, class: "form-control form-control-lg", placeholder: "Email", required: true %>
            </div>

            <div class="form-group">
              <label><i class="fa fa-phone mr-2 text-primary"></i> Phone*</label>
              <%= f.text_field :phone, class: "form-control form-control-lg", placeholder: "Phone", required: true %>
            </div>

            <div class="form-group">
              <label><i class="fa fa-graduation-cap mr-2 text-primary"></i> Batch*</label>
              <%= f.number_field :batch, class: "form-control form-control-lg", placeholder: "Batch", required: true %>
            </div>

            <div class="form-group">
              <label><i class="fa fa-id-card mr-2 text-primary"></i> Student ID*</label>
              <%= f.number_field :student_id, class: "form-control form-control-lg", placeholder: "Student ID", required: true %>
            </div>

            <div class="form-group">
              <label><i class="fa fa-building mr-2 text-primary"></i> Current Company(optional)</label>
              <%= f.text_field :current_company, class: "form-control form-control-lg", placeholder: "Current Company" %>
            </div>

            <div class="form-group mt-4">
              <%= f.submit "Register", class: "btn btn-primary button1 btn-lg btn-block font-weight-bold rounded-pill" %>
            </div>

          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>




<!-- Header Section Start -->

  <div class="overlay">
    <span></span>
    <span></span>
  </div>
  <nav class="navbar navbar-expand-md bg-inverse fixed-top scrolling-navbar" style="background: cornflowerblue">
    <div class="container">
      <a href="/" class="navbar-brand">
        <%= image_tag('logo.webp',width: '80px')%>
        <%#= image_tag('logo.png',width: '80px') unless @setting.present? && @setting.logo.present? %>
        <%#= image_tag(@setting.logo.url,width: '80px') if @setting.present? && @setting.logo.present? %>
      </a>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
        <i class="lni-menu"></i>
      </button>
      <div class="collapse navbar-collapse" id="navbarCollapse">
        <ul class="navbar-nav mr-auto w-100 justify-content-end">
          <li class="nav-item">
            <%= link_to "Home", root_path, class: "nav-link" %>
          </li>


          <li class="nav-item">
            <%= link_to "About Us", current_page?(root_path) ? "#about-us" : root_path(anchor: 'about-us'), class: "nav-link page-scroll" %>
            <!--            <a class="nav-link page-scroll" href="#about-us">About Us</a>-->
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle page-scroll" href="#" id="exploreMenu" role="button"
               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Mission & Vision
            </a>
            <div class="dropdown-menu" aria-labelledby="exploreMenu">
              <%= link_to "Mission", current_page?(root_path) ? "#missin" : root_path(anchor: 'missin'), class: "dropdown-item page-scroll" %>
              <%= link_to "Vision", current_page?(root_path) ? "#missin" : root_path(anchor: 'missin'), class: "dropdown-item page-scroll" %>
<!--              <a class="dropdown-item page-scroll" href="#missin">Mission</a>-->
<!--              <a class="dropdown-item page-scroll" href="#vission">Vision</a>-->
            </div>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle page-scroll" href="#" id="exploreMenu" role="button"
               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Activity
            </a>
            <div class="dropdown-menu" aria-labelledby="exploreMenu">
              <%= link_to "Recent Activity", current_page?(root_path) ? "#recent-activity" : root_path(anchor: 'recent-activity'), class: "dropdown-item page-scroll" %>
              <%= link_to "Gallary", current_page?(root_path) ? "#gallary" : root_path(anchor: 'gallary'), class: "dropdown-item page-scroll" %>
            </div>
          </li>


          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle page-scroll" href="#" id="exploreMenu" role="button"
               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Committee
            </a>
            <div class="dropdown-menu" aria-labelledby="exploreMenu">
              <%= link_to "Committee", current_page?(root_path) ? "#commitee" : root_path(anchor: 'commitee'),  class: "dropdown-item page-scroll" %>
              <%= link_to "Previous Committee",current_page?(root_path) ? "#commitee" : root_path(anchor: 'commitee'), class: "dropdown-item page-scroll" %>
            </div>
          </li>

          <li class="nav-item">
            <%= link_to "Contact", current_page?(root_path) ? "#contact" : root_path(anchor: 'contact'), class: "nav-link page-scroll" %>
          </li>

          <li class="nav-item">
            <%if user_signed_in? %>
              <%= link_to destroy_user_session_path, method: :delete, class: 'nav-link page-scroll', "data-toggle" => "modal", "data-target" => "#logoutModal" do %>
<!--                <i class="fa fa-sign-out fa-sm fa-fw mr-2 text-gray-400"></i>-->
                Logout
              <% end %>
              <%#= link_to "Sign out", destroy_user_session_path, :method => :delete %>
            <%else %>

              <%= link_to new_user_session_path,  class: 'nav-link page-scroll' do %>
<!--                <i class="fa# fa-sign-out# fa-sm fa-fw mr-2# text-gray-400#"></i>-->
                login
              <% end %>
            <%end %>
          </li>

        </ul>
      </div>
    </div>
  </nav>

<!-- Header Section End -->
<script type="application/javascript">
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll('a.page-scroll[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    window.scrollTo({
                        top: target.offsetTop - 70, // adjust navbar height
                        behavior: 'smooth'
                    });
                }
            });
        });
    });

</script>
<!DOCTYPE html>
<html>

<head>
  <title>CU CSE ALUMNI</title>
  <link rel="shortcut icon" href="<%= asset_path('/images/bssas.jpeg') %>" type="image/png">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" integrity="sha384-gfdkjb5BdAXd+lj+gudLWI+BXq4IuLW5IT+brZEZsLFm++aCMlF1V92rMkPaX4PP" crossorigin="anonymous">
  <style>
      @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap');

      * {
          box-sizing: border-box;
      }

      body {
          margin: 0;
          font-family: 'Poppins', sans-serif;
          background: linear-gradient(135deg, #6a11cb, #2575fc);
          animation: fadeIn 1s ease-in;
      }

      .form_wrapper {
          min-height: 100vh;
          display: flex;
          justify-content: center;
          align-items: center;
          padding: 20px;
          animation: slideIn 1s ease;
      }

      .form_container {
          background: #ffffff;
          border-radius: 15px;
          padding: 50px 40px 40px;
          box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
          width: 100%;
          max-width: 500px;
          position: relative;
          animation: popIn 0.6s ease-out;
      }

      .logo {
          position: absolute;
          top: -50px;
          left: 50%;
          transform: translateX(-50%);
          border: 5px solid white;
          border-radius: 50%;
          background-color: white;
          padding: 5px;
          box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
          animation: popIn 0.6s ease-out;
      }

      .title_container h2 {
          text-align: center;
          margin-bottom: 25px;
          color: #333;
          margin-top: 40px;
      }

      .input_field {
          display: flex;
          align-items: center;
          margin-bottom: 15px;
          background: #f1f1f1;
          padding: 10px 15px;
          border-radius: 8px;
      }

      .input_field span {
          margin-right: 10px;
          color: #6a11cb;
          font-size: 18px;
      }

      .input_field input {
          border: none;
          background: transparent;
          width: 100%;
          outline: none;
          font-size: 16px;
          color: #333;
      }

      .button {
          width: 100%;
          margin-top: 20px;
          padding: 12px;
          background: linear-gradient(135deg, #6a11cb, #2575fc);
          color: white;
          border: none;
          font-weight: bold;
          font-size: 16px;
          border-radius: 8px;
          cursor: pointer;
          transition: background 0.3s ease, transform 0.2s ease;
      }

      .button:hover {
          background: linear-gradient(135deg, #5b0ecc, #1c60f0);
          transform: translateY(-2px);
      }

      @keyframes fadeIn {
          from {
              opacity: 0;
          }
          to {
              opacity: 1;
          }
      }

      @keyframes slideIn {
          from {
              transform: translateY(50px);
              opacity: 0;
          }
          to {
              transform: translateY(0);
              opacity: 1;
          }
      }

      @keyframes popIn {
          from {
              transform: scale(0.95);
              opacity: 0;
          }
          to {
              transform: scale(1);
              opacity: 1;
          }
      }

      /* Responsive rules */
      @media screen and (max-width: 768px) {
          .form_container {
              padding: 40px 25px 30px;
          }

          .title_container h2 {
              font-size: 20px;
              margin-top: 30px;
          }

          .input_field {
              padding: 8px 12px;
          }

          .input_field input {
              font-size: 15px;
          }

          .button {
              font-size: 15px;
          }

          .logo img {
              width: 80px !important;
          }
      }

      @media screen and (max-width: 480px) {
          .input_field {
              flex-direction: row;
          }

          .input_field span {
              font-size: 16px;
          }

          .input_field input {
              font-size: 14px;
          }

          .logo {
              top: -45px;
          }
      }
  </style>
</head>

<body>
<div class="container">
  <%= yield %>
</div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Required meta tags -->
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="keywords" content="Bootstrap, Landing page, Template, Business, Service">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="author" content="Grayrids">
  <title>CU CSE ALUMNI</title>
  <!--====== Favicon Icon ======-->
<!--  <link rel="stylesheet" href="path/to/font-awesome/css/font-awesome.min.css">-->

  <link rel="shortcut icon" href="../images/img/2.png" type="image/png">
  <!-- Bootstrap CSS -->

  <%= stylesheet_link_tag 'landing_page', media: 'all', 'data-turbolinks-track': 'reload' %>
  <%= stylesheet_link_tag 'https://cdn.lineicons.com/2.0/LineIcons.css' %>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" integrity="sha384-gfdkjb5BdAXd+lj+gudLWI+BXq4IuLW5IT+brZEZsLFm++aCMlF1V92rMkPaX4PP" crossorigin="anonymous">
  <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css", integrity: "sha512-dYZY...", crossorigin: "anonymous" %>

  <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
</head>

<body>
<header>
<%= render 'shared/landing_top' %>
</header>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap');

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        animation: fadeIn 1s ease-in;
    }

    .jolchap-background {
        position: relative;
        background: url(<%= asset_path("logo.webp") %>) no-repeat center center;
        background-size: 250px;
        background-repeat: no-repeat;
        background-position: center;
        opacity: 0.05;
        z-index: 0;
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
    }

    .jolchap-wrapper {
        position: relative;
        z-index: 1; /* keep form elements above background */
    }

    .card.with-jolchap {
        position: relative;
        overflow: hidden;
    }
    .from-card-margin{
        margin-top: 6%;
        margin-bottom: 4%;
    }

    @media (min-width: 320px) and (max-width: 480px) {
    .navbar-brand img {
        width: 45px;
    }
    }
    .button1 {
        width: 100%;
        margin-top: 20px;
        padding: 12px;
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        color: white;
        border: none;
        font-weight: bold;
        font-size: 16px;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .button1:hover {
        background: linear-gradient(135deg, #5b0ecc, #1c60f0);
        transform: translateY(-2px);
    }

</style>

<div class="from-card-margin">
  <%= yield %>
</div>

<%#= render 'shared/landing_footer' %>
<%= javascript_include_tag 'landing_page', 'data-turbolinks-track': 'reload' %>

</body>
</html>

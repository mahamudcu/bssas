<div class="panel-header bg-primary-gradient">
  <div class="page-inner py-5">
    <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
      <div>
        <h2 class="text-white pb-2 fw-bold">Subscriptions</h2>
        <h5 class="text-white op-7 mb-2">Manage member subscriptions</h5>
      </div>
      <div class="ml-md-auto py-2 py-md-0">
        <%= link_to new_admin_subscription_path, class: "btn btn-white btn-border btn-round" do %>
          <i class="fa fa-plus"></i> New Subscription
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="page-inner mt--5">
  <!-- Summary Cards -->
  <div class="row">
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-success bubble-shadow-small">
                <i class="fas fa-check-circle"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Active</p>
                <h4 class="card-title"><%= Subscription.active.count %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-info bubble-shadow-small">
                <i class="fas fa-calendar-alt"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Monthly</p>
                <h4 class="card-title"><%= Subscription.monthly.active.count %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-primary bubble-shadow-small">
                <i class="fas fa-calendar-check"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Yearly</p>
                <h4 class="card-title"><%= Subscription.yearly.active.count %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-warning bubble-shadow-small">
                <i class="fas fa-exclamation-triangle"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Due</p>
                <h4 class="card-title"><%= Subscription.due.count %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card">
    <div class="card-body py-2">
      <%= form_tag admin_subscriptions_path, method: :get, class: 'form-inline' do %>
        <div class="form-group mr-2 mb-2">
          <%= select_tag :plan_type, options_for_select([['All Plans', ''], ['Monthly', 'monthly'], ['Yearly', 'yearly']], params[:plan_type]), class: 'form-control' %>
        </div>
        <div class="form-group mr-2 mb-2">
          <%= select_tag :status, options_for_select([['All Status', ''], ['Active', 'active'], ['Expired', 'expired'], ['Cancelled', 'cancelled']], params[:status]), class: 'form-control' %>
        </div>
        <div class="form-group mr-2 mb-2">
          <%= submit_tag 'Filter', class: 'btn btn-primary btn-round' %>
        </div>
        <div class="form-group mb-2">
          <%= link_to 'Clear', admin_subscriptions_path, class: 'btn btn-secondary btn-round' %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Subscriptions Table -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">All Subscriptions</div>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover table-striped">
          <thead>
            <tr>
              <th>Member</th>
              <th>Plan</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Start Date</th>
              <th>End Date</th>
              <th>Next Due</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @subscriptions.each do |sub| %>
              <tr>
                <td><%= sub.user&.name %></td>
                <td><span class="badge badge-<%= sub.plan_type == 'monthly' ? 'info' : 'primary' %>"><%= sub.plan_type.titleize %></span></td>
                <td class="text-right"><%= number_with_delimiter(sub.amount, delimiter: ',') %></td>
                <td>
                  <span class="badge badge-<%= sub.status == 'active' ? 'success' : (sub.status == 'expired' ? 'danger' : 'secondary') %>">
                    <%= sub.status.titleize %>
                  </span>
                </td>
                <td><%= sub.start_date.strftime('%d %b %Y') %></td>
                <td><%= sub.end_date.strftime('%d %b %Y') %></td>
                <td><%= sub.next_due_date&.strftime('%d %b %Y') || '-' %></td>
                <td>
                  <%= link_to admin_subscription_path(sub), class: 'btn btn-sm btn-primary btn-round' do %>
                    <i class="fa fa-eye"></i>
                  <% end %>
                  <%= link_to edit_admin_subscription_path(sub), class: 'btn btn-sm btn-warning btn-round' do %>
                    <i class="fa fa-edit"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @subscriptions.empty? %>
        <div class="text-center py-4">
          <i class="fas fa-id-card fa-3x text-muted mb-3"></i>
          <p class="text-muted">No subscriptions found</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

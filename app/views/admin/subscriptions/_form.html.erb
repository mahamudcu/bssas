<div class="card-body">
  <div class="row">
    <div class="col-md-6">
      <div class="form-group">
        <label>Member <span class="text-danger">*</span></label>
        <%= f.select :user_id, @users.map { |u| ["#{u.name} (#{u.email})", u.id] }, { prompt: 'Select Member' }, class: 'form-control' %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <label>Plan Type <span class="text-danger">*</span></label>
        <%= f.select :plan_type, [['Monthly', 'monthly'], ['Yearly', 'yearly']], { prompt: 'Select Plan' }, class: 'form-control' %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-6">
      <div class="form-group">
        <label>Amount (BDT) <span class="text-danger">*</span></label>
        <%= f.number_field :amount, class: 'form-control', step: '0.01', min: '0' %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <label>Status</label>
        <%= f.select :status, [['Active', 'active'], ['Expired', 'expired'], ['Cancelled', 'cancelled']], {}, class: 'form-control' %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-4">
      <div class="form-group">
        <label>Start Date</label>
        <%= f.date_field :start_date, class: 'form-control' %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-group">
        <label>End Date</label>
        <%= f.date_field :end_date, class: 'form-control' %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-group">
        <label>Next Due Date</label>
        <%= f.date_field :next_due_date, class: 'form-control' %>
      </div>
    </div>
  </div>
  <div class="form-group">
    <label>Notes</label>
    <%= f.text_area :notes, class: 'form-control', rows: 3 %>
  </div>
</div>
<div class="card-footer text-right">
  <%= link_to 'Cancel', admin_subscriptions_path, class: 'btn btn-secondary btn-round mr-2' %>
  <%= f.submit class: 'btn btn-primary btn-round' %>
</div>

<div class="panel-header bg-primary-gradient">
  <div class="page-inner py-5">
    <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
      <div>
        <h2 class="text-white pb-2 fw-bold">Subscription Details</h2>
        <h5 class="text-white op-7 mb-2"><%= @subscription.user&.name %> - <%= @subscription.plan_type.titleize %> Plan</h5>
      </div>
      <div class="ml-md-auto py-2 py-md-0">
        <%= link_to admin_subscriptions_path, class: "btn btn-white btn-border btn-round" do %>
          <i class="fa fa-arrow-left"></i> Back
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="page-inner mt--5">
  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <div class="card-title">Subscription Info</div>
        </div>
        <div class="card-body">
          <table class="table table-bordered">
            <tr><th>Member</th><td><%= @subscription.user&.name %></td></tr>
            <tr><th>Email</th><td><%= @subscription.user&.email %></td></tr>
            <tr><th>Plan</th><td><span class="badge badge-info"><%= @subscription.plan_type.titleize %></span></td></tr>
            <tr><th>Amount</th><td><strong><%= number_with_delimiter(@subscription.amount, delimiter: ',') %> BDT</strong></td></tr>
            <tr><th>Status</th><td><span class="badge badge-<%= @subscription.status == 'active' ? 'success' : 'danger' %>"><%= @subscription.status.titleize %></span></td></tr>
            <tr><th>Start Date</th><td><%= @subscription.start_date.strftime('%d %b %Y') %></td></tr>
            <tr><th>End Date</th><td><%= @subscription.end_date.strftime('%d %b %Y') %></td></tr>
            <tr><th>Next Due</th><td><%= @subscription.next_due_date&.strftime('%d %b %Y') || '-' %></td></tr>
            <tr><th>Total Paid</th><td><%= number_with_delimiter(@subscription.total_paid, delimiter: ',') %> BDT</td></tr>
          </table>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <div class="card-title">Payment History</div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped table-sm">
              <thead>
                <tr><th>Date</th><th>Amount</th><th>Method</th><th>Status</th></tr>
              </thead>
              <tbody>
                <% @payments.each do |p| %>
                  <tr>
                    <td><%= p.created_at.strftime('%d %b %Y') %></td>
                    <td><%= number_with_delimiter(p.amount, delimiter: ',') %></td>
                    <td><%= p.payment_method&.titleize %></td>
                    <td><span class="badge <%= p.status_badge_class %>"><%= p.status.titleize %></span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @payments.empty? %>
            <p class="text-muted text-center">No payments yet</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="panel-header bg-primary-gradient">
  <div class="page-inner py-5">
    <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
      <div>
        <h2 class="text-white pb-2 fw-bold">Payment Management</h2>
        <h5 class="text-white op-7 mb-2">View and manage all payments</h5>
      </div>
      <div class="ml-md-auto py-2 py-md-0">
        <%= link_to new_admin_payment_path, class: "btn btn-white btn-border btn-round mr-2" do %>
          <i class="fa fa-plus"></i> Add Manual Payment
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="page-inner mt--5">
  <!-- Summary Cards -->
  <div class="row">
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-success bubble-shadow-small">
                <i class="fas fa-check-circle"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Successful</p>
                <h4 class="card-title"><%= Payment.successful.count %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-warning bubble-shadow-small">
                <i class="fas fa-clock"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Pending</p>
                <h4 class="card-title"><%= Payment.pending_payments.count %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-primary bubble-shadow-small">
                <i class="fas fa-money-bill-wave"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Total Collected</p>
                <h4 class="card-title"><%= number_with_delimiter(Payment.successful.sum(:amount), delimiter: ',') %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card card-stats card-round">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-icon">
              <div class="icon-big text-center icon-danger bubble-shadow-small">
                <i class="fas fa-times-circle"></i>
              </div>
            </div>
            <div class="col col-stats ml-3 ml-sm-0">
              <div class="numbers">
                <p class="card-category">Failed</p>
                <h4 class="card-title"><%= Payment.failed.count %></h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Filters</div>
    </div>
    <div class="card-body">
      <%= form_tag admin_payments_path, method: :get, class: 'form-inline' do %>
        <div class="form-group mr-2 mb-2">
          <%= select_tag :status, options_for_select([['All Status', ''], ['Pending', 'pending'], ['Success', 'success'], ['Failed', 'failed'], ['Cancelled', 'cancelled']], params[:status]), class: 'form-control' %>
        </div>
        <div class="form-group mr-2 mb-2">
          <%= select_tag :payment_type, options_for_select([['All Types', ''], ['Monthly', 'membership_monthly'], ['Yearly', 'membership_yearly'], ['Event Fee', 'event_fee']], params[:payment_type]), class: 'form-control' %>
        </div>
        <div class="form-group mr-2 mb-2">
          <%= select_tag :payment_method, options_for_select([['All Methods', ''], ['SSLCommerz', 'sslcommerz'], ['Cash', 'cash'], ['Bank Transfer', 'bank_transfer'], ['Cheque', 'cheque']], params[:payment_method]), class: 'form-control' %>
        </div>
        <div class="form-group mr-2 mb-2">
          <%= month_field_tag :month, params[:month], class: 'form-control', placeholder: 'Month' %>
        </div>
        <div class="form-group mr-2 mb-2">
          <%= submit_tag 'Filter', class: 'btn btn-primary btn-round' %>
        </div>
        <div class="form-group mb-2">
          <%= link_to 'Clear', admin_payments_path, class: 'btn btn-secondary btn-round' %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Payments Table -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">All Payments</div>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover table-striped">
          <thead>
            <tr>
              <th>Transaction ID</th>
              <th>Member</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Method</th>
              <th>Status</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @payments.each do |payment| %>
              <tr>
                <td><code><%= payment.transaction_id %></code></td>
                <td><%= payment.user&.name %></td>
                <td><%= payment.payment_type_label %></td>
                <td class="text-right"><strong><%= number_with_delimiter(payment.amount, delimiter: ',') %></strong></td>
                <td><%= payment.payment_method&.titleize %></td>
                <td><span class="badge <%= payment.status_badge_class %>"><%= payment.status&.titleize %></span></td>
                <td><%= payment.created_at.strftime('%d %b %Y %H:%M') %></td>
                <td>
                  <%= link_to admin_payment_path(payment), class: 'btn btn-sm btn-primary btn-round' do %>
                    <i class="fa fa-eye"></i>
                  <% end %>
                  <% if payment.pending? && payment.manual_payment? %>
                    <%= link_to approve_admin_payment_path(payment), method: :patch, class: 'btn btn-sm btn-success btn-round', data: { confirm: 'Approve this payment?' } do %>
                      <i class="fa fa-check"></i>
                    <% end %>
                    <%= link_to reject_admin_payment_path(payment), method: :patch, class: 'btn btn-sm btn-danger btn-round', data: { confirm: 'Reject this payment?' } do %>
                      <i class="fa fa-times"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @payments.empty? %>
        <div class="text-center py-4">
          <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
          <p class="text-muted">No payments found</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

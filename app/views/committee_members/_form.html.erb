<%= form_with(model: committee_member, local: true) do |form| %>
  <div class="card-body">
    <% if committee_member.errors.any? %>
      <div id="error_explanation" class="alert alert-danger">
        <h4><%= pluralize(committee_member.errors.count, "error") %> prohibited this committee member from being saved:</h4>
        <ul>
          <% committee_member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <%= form.label :user_id, "Member" %>
          <%= form.collection_select :user_id, User.all, :id, :name, { prompt: "Select Member" }, { class: "form-control" } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <%= form.label :committee_id, "Committee" %>
          <%= form.collection_select :committee_id, Committee.all, :id, :title, { prompt: "Select Committee" }, { class: "form-control" } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <%= form.label :committee_designation_id, "Committee Designation" %>
          <%= form.collection_select :committee_designation_id, CommitteeDesignation.all, :id, :title, { prompt: "Select Committee Designation" }, { class: "form-control" } %>
        </div>
      </div>

      <div class="col-md-6">
        <div class="form-group">
          <%= form.label :is_approved, "Approved Status" %>
          <div>
            <%= form.check_box :is_approved, class: "form-check-input" %>
            <label class="form-check-label">Is Approved</label>
          </div>
        </div>
      </div>

      <div class="col-md-12">
        <div class="form-group">
          <%= form.label :description %>
          <%= form.text_area :description, class: "form-control", rows: 4, placeholder: "Enter description..." %>
        </div>
      </div>
    </div>

    <div class="card-action">
      <%= form.submit 'Submit', class: 'btn btn-success' %>
      <%= link_to 'Back', committee_members_path, class: "btn btn-danger" %>
    </div>
  </div>
<% end %>
